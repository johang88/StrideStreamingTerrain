namespace StrideTerrain.Vegetation
{
    shader GrassPopulateInstances : ComputeShaderBase, TerrainQuery, Math
    {
        stage float3 CameraPosition;
        stage uint Size;
        stage uint InstanceCount;
        stage float CellSize;
        stage float FadeStartFraction;
        stage float MinScale;
        stage float MaxScale;
        stage float2 Seed;
        stage bool RotateAlongTerrainNormal;
        stage float Clumpiness = 0.5f;
        stage float ClumpSize = 32.0f;
        stage uint ValidBackgroundTexturesIds[5];

        struct GrassInstance
        {
            float4 PositionScale;
            float4 Rotation;
        };

        stage RWStructuredBuffer<GrassInstance> Instances;
        stage RWByteAddressBuffer InstancesCounter;

        override void Compute()
        {
            uint2 tid = streams.DispatchThreadId.xy;
            uint index = tid.y * Size + tid.x;
            if (index >= InstanceCount)
                return;

            // Hex grid: rows packed at sqrt(3)/2 spacing, odd rows offset by half column
            float colSpacing = CellSize;
            float rowSpacing = CellSize * 0.8660254; // sqrt(3)/2
            float radius = Size * CellSize * 0.5;

            // Camera's absolute grid cell
            int cameraCol = (int)floor(CameraPosition.x / colSpacing);
            int cameraRow = (int)floor(CameraPosition.z / rowSpacing);

            // Snapped camera = grid-aligned origin for stable placement
            float2 snappedCameraXZ = float2(cameraCol * colSpacing, cameraRow * rowSpacing);

            // This thread's absolute hex cell in world grid
            int halfSize = (int)(Size / 2);
            int absCol = cameraCol + (int)tid.x - halfSize;
            int absRow = cameraRow + (int)tid.y - halfSize;

            // Cell center in world space
            float2 cellCenter;
            cellCenter.x = absCol * colSpacing;
            cellCenter.y = absRow * rowSpacing;

            // Hex offset: shift odd rows by half a column
            if ((abs(absRow) & 1) != 0)
                cellCenter.x += colSpacing * 0.5;

            // Per-cell seed from absolute grid coordinates — stable regardless of camera
            float2 cellSeed = float2((float)absCol, (float)absRow) + Seed;

            float rndPosX = Hash21(cellSeed);
            float rndPosZ = Hash21(cellSeed.yx + 19.19);
            float rndScale = Hash21(cellSeed * 31.0);
            float rndRot = Hash21(cellSeed * 73.0);

            // Jitter within hex cell
            float2 jitter = (float2(rndPosX, rndPosZ) - 0.5) * CellSize * 0.5;
            float2 worldPosXZ = cellCenter + jitter;

            // Distance cull relative to snapped camera
            float2 localPos = worldPosXZ - snappedCameraXZ;
            float distSq = dot(localPos, localPos);
            if (distSq > radius * radius)
                return;

            // Distance fade — early out before expensive terrain queries
            float3 position;
            position.xz = worldPosXZ;

            float distanceToCamera = distance(CameraPosition.xz, position.xz);
            float startFadeRadius = radius * FadeStartFraction;
            float fade = smoothstep(radius, startFadeRadius, distanceToCamera);
            float scale = fade * lerp(MinScale, MaxScale, rndScale);

            if (scale < 0.01f)
                return;

            // Clumping: layered value noise for organic density variation
            if (Clumpiness > 0.0f)
            {
                float2 noiseCoord1 = worldPosXZ / ClumpSize + Seed * 5.7;
                float2 noiseCoord2 = worldPosXZ / (ClumpSize * 0.4) + Seed * 13.3;

                float density = ValueNoise(noiseCoord1) * 0.7 + ValueNoise(noiseCoord2) * 0.3;

                // Higher Clumpiness = more area rejected
                float threshold = Clumpiness * 0.6;

                // Soft edge: scale tapers near clump boundaries
                float clumpFade = saturate((density - threshold) / (1.0 - threshold));
                scale *= clumpFade;

                if (scale < 0.01f)
                    return;
            }

            // Terrain validity check — after all cheap culling
            float2 terrainUv = GetTerrainAtlasUv(position.x, position.z);
            uint backgroundTextureIndex = GetBackgroundTextureIndexAt(terrainUv);

            bool isValid = false;
            [unroll]
            for (int i = 0; i < 5; i++)
            {
                if (ValidBackgroundTexturesIds[i] == backgroundTextureIndex)
                    isValid = true;
            }

            if (!isValid)
                return;

            // Height + rotation only for surviving instances
            position.y = GetTerrainHeightAt(terrainUv);

            float rotationAngle = (rndRot * 2.0 - 1.0) * PI;
            float3 terrainNormal = RotateAlongTerrainNormal ? GetTerrainNormalAt(terrainUv) : float3(0, 1, 0);

            float4 rotation = QuaternionMultiply(
                CreateRotationAxisYQuaternion(float3(0, 1, 0), rotationAngle),
                CreateQuaternionFromUpToNormal(terrainNormal));

            GrassInstance grassInstance;
            grassInstance.PositionScale = float4(position.xyz, scale);
            grassInstance.Rotation = rotation;

            uint appendIndex;
            InstancesCounter.InterlockedAdd(0, 1, appendIndex);
            Instances[appendIndex] = grassInstance;
        }

        float Hash21(float2 p)
        {
            p = frac(p * 0.1031);
            p += dot(p, p.yx + 33.33);
            return frac((p.x + p.y) * p.x * p.y);
        }

        // Smooth 2D value noise via bilinear interpolation of hash values
        float ValueNoise(float2 p)
        {
            float2 i = floor(p);
            float2 f = frac(p);

            // Hermite interpolation for smooth transitions
            float2 u = f * f * (3.0 - 2.0 * f);

            float a = Hash21(i);
            float b = Hash21(i + float2(1, 0));
            float c = Hash21(i + float2(0, 1));
            float d = Hash21(i + float2(1, 1));

            return lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y);
        }

        float4 QuaternionMultiply(float4 left, float4 right)
        {
            float4 result;

            float lx = left.x;
            float ly = left.y;
            float lz = left.z;
            float lw = left.w;
            float rx = right.x;
            float ry = right.y;
            float rz = right.z;
            float rw = right.w;

            result.x = (rx * lw + lx * rw + ry * lz) - (rz * ly);
            result.y = (ry * lw + ly * rw + rz * lx) - (rx * lz);
            result.z = (rz * lw + lz * rw + rx * ly) - (ry * lx);
            result.w = (rw * lw) - (rx * lx + ry * ly + rz * lz);

            return result;
        }

        float4 CreateRotationAxisYQuaternion(float3 axis, float angle)
        {
            float halfAngle = angle * 0.5f;
            float s = sin(halfAngle);
            float c = cos(halfAngle);

            float4 result;
            result.x = axis.x * s;
            result.y = axis.y * s;
            result.z = axis.z * s;
            result.w = c;

            return result;
        }

        // Specialized quaternion from (0,1,0) to target normal
        float4 CreateQuaternionFromUpToNormal(float3 target)
        {
            float real = 1.0 + target.y;
            if (real < 1e-6f)
                return float4(0, 0, 1, 0);

            float3 axis = float3(target.z, 0, -target.x);
            return normalize(float4(axis, real));
        }
    };
}
