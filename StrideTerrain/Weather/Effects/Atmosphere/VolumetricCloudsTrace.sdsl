namespace StrideTerrain.Weather.Effects.Atmosphere
{
    // Pass 1: Traces at quarter resolution — ALL pixels active every frame.
    // Uses a 4x4 Bayer matrix to cycle which full-res sub-pixel each quarter-res
    // texel represents, matching the Flower engine approach.
    shader VolumetricCloudsTrace : ComputeShaderBase, VolumetricClouds
    {
        stage Texture2D<float4> TransmittanceLUT;
        stage Texture2D<float4> SkyLuminanceLUT;
        stage Texture3D<float4> BasicNoiseTexture;
        stage Texture3D<float4> DetailNoiseTexture;
        stage Texture2D<float4> WeatherMapTexture;
        stage RWTexture2D<float4> OutputTexture;

        cbuffer CloudTrace
        {
            CloudParameters Clouds;
            AtmosphereParameters Atmosphere;
            float4x4 InvViewProjection;
            float3 SunDirection;
            [Color] float3 SunColor;
            float3 CameraPosition;
            float2 TraceResolution;    // quarter-res (width/4, height/4)
            float2 FullResolution;     // full viewport resolution
            uint FrameIndex;
        }

        // Inverse Bayer lookup: given frame slot (0-15), return the (dx, dy) sub-pixel
        // offset within a 4x4 tile. This is the inverse of the standard 4x4 Bayer matrix:
        //  0  8  2 10
        // 12  4 14  6
        //  3 11  1  9
        // 15  7 13  5
        uint2 GetBayerOffset(uint slot)
        {
            if (slot ==  0) return uint2(0, 0);
            if (slot ==  1) return uint2(2, 2);
            if (slot ==  2) return uint2(2, 0);
            if (slot ==  3) return uint2(0, 2);
            if (slot ==  4) return uint2(1, 1);
            if (slot ==  5) return uint2(3, 3);
            if (slot ==  6) return uint2(3, 1);
            if (slot ==  7) return uint2(1, 3);
            if (slot ==  8) return uint2(1, 0);
            if (slot ==  9) return uint2(3, 2);
            if (slot == 10) return uint2(3, 0);
            if (slot == 11) return uint2(1, 2);
            if (slot == 12) return uint2(0, 1);
            if (slot == 13) return uint2(2, 3);
            if (slot == 14) return uint2(2, 1);
            return uint2(0, 3); // slot 15
        }

        // Interleaved gradient noise (Jimenez 2014) — much better temporal
        // distribution than white noise hash. Produces well-distributed values
        // that minimize visible patterns when used as ray march jitter.
        float InterleavedGradientNoise(float2 pixelCoord, uint frameIndex)
        {
            pixelCoord += float(frameIndex) * 5.588238;
            return frac(52.9829189 * frac(0.06711056 * pixelCoord.x + 0.00583715 * pixelCoord.y));
        }

        override void Compute()
        {
            uint2 quarterCoord = streams.DispatchThreadId.xy;
            uint traceW = (uint)TraceResolution.x;
            uint traceH = (uint)TraceResolution.y;

            if (quarterCoord.x >= traceW || quarterCoord.y >= traceH)
                return;

            // Determine which full-res sub-pixel this quarter-res texel represents
            uint bayerSlot = FrameIndex % 16;
            uint2 bayerOffset = GetBayerOffset(bayerSlot);
            uint2 fullResCoord = quarterCoord * 4 + bayerOffset;

            // Compute UV in full-res space
            float2 uv = (float2(fullResCoord) + 0.5) / FullResolution;

            // Reconstruct world ray
            float4 unprojected = mul(float4(uv * float2(2.0, -2.0) - float2(1.0, -1.0), 0, 1), InvViewProjection);
            unprojected.xyz /= unprojected.w;
            float3 rayDir = normalize(unprojected.xyz - CameraPosition);

            // Per-pixel jitter using interleaved gradient noise
            float jitter = InterleavedGradientNoise(float2(quarterCoord), FrameIndex);

            VolumetricCloudResult cloudResult = RayMarchClouds(
                CameraPosition, rayDir,
                SunDirection, SunColor,
                Clouds, Atmosphere,
                BasicNoiseTexture, DetailNoiseTexture, WeatherMapTexture,
                TransmittanceLUT, SkyLuminanceLUT,
                Time, jitter);

            OutputTexture[quarterCoord] = float4(cloudResult.scattering, cloudResult.transmittance);
        }
    };
}
