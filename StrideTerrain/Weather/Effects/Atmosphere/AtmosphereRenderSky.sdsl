namespace StrideTerrain.Weather.Effects.Atmosphere
{
    shader AtmosphereRenderSky<bool RenderSun, bool EnableHeightFog> : ImageEffectShader, AtmosphereBase, FogBase
    {
        stage Texture2D<float4> TransmittanceLUT;
        stage Texture2D<float4> SkyLuminanceLUT;
        stage Texture2D<float4> MultiScatteringLUT;
        stage Texture2D<float4> SkyViewLUT;

		struct CloudParameters
        {
            float Scale;
            float Speed;
            float Cloudiness;
            float CirrusAmount;
        };

        cbuffer Atmosphere
        {
			AtmosphereParameters Atmosphere;
            FogParameters Fog;
            CloudParameters Clouds;
            float4x4 InvViewProjection;
            float3 SunDirection;
            [Color] float3 SunColor;
            float3 CameraPosition;
            float2 InvResolution;
        }

        float3 GetSunLuminance(float3 worldPosition, float3 worldDirection, float3 sunDirection, float3 sunIlluminance, AtmosphereParameters atmosphere, Texture2D<float4> transmittanceLutTexture)
		{
			float3 retval = 0;

			float t = RaySphereIntersectNearest(worldPosition, worldDirection, float3(0.0f, 0.0f, 0.0f), atmosphere.BottomRadius);
			if (t < 0.0f) // no intersection with planet
			{
				const float sunApexAngleDegree = 2.4; // Big sun
				const float sunHalfApexAngleRadian = 0.5 * sunApexAngleDegree * PI / 180.0;
				const float sunCosHalfApexAngle = cos(sunHalfApexAngleRadian);

				sunIlluminance *= 10;

				float VdotL = dot(worldDirection, sunDirection);
				if (VdotL >= sunCosHalfApexAngle)
				{
					retval = sunIlluminance;
				}
				else
				{
					float offset = sunCosHalfApexAngle - VdotL;
					float gaussianBloom = exp(-offset * 50000.0) * 0.5;
					float invBloom = 1.0 / (0.02 + offset * 3000.0) * 0.01;
					retval = float(gaussianBloom + invBloom).xxx * sunIlluminance;
				}

				// https://www.shadertoy.com/view/NtsBzB
				const float starsAmount = 0.6f;
				if (starsAmount > 0.0f)
				{
					float starsVisibility = pow(saturate(1 - sunDirection.y), 2);
					float3 starsDirection = normalize(worldDirection); // could be view vector for example
					float starsThreshold = lerp(24, 12, starsAmount); // modifies the number of stars that are visible
					float starsExposure = lerp(0, 500.0f, starsVisibility); // modifies the overall strength of the stars

					float stars = pow(saturate(NoiseGradient3d(starsDirection * 200.0f)), starsThreshold) * starsExposure;
					stars *= lerp(0.4, 1.4, NoiseGradient3d(starsDirection * 100.0f + Time));

					retval += stars;
				}

				const float3 atmosphereTransmittance = GetAtmosphereTransmittance(worldPosition, worldDirection, atmosphere, transmittanceLutTexture);
				retval *= atmosphereTransmittance;
			}

			return retval;
		}

        stage override float4 Shading()
        {
            float2 pixelPosition = streams.ShadingPosition.xy;
            float4 unprojected = mul(float4((pixelPosition * InvResolution) * float2(2.0, -2.0) - float2(1.0, -1.0), 0, 1), InvViewProjection);
	        unprojected.xyz /= unprojected.w;

            const float3 V = normalize(unprojected.xyz - CameraPosition);

            AtmosphereParameters atmosphere = Atmosphere;

            float3 skyRelativePosition = CameraPosition;

            float3 worldPosition = GetCameraPlanetPos(atmosphere, skyRelativePosition);
            float3 worldDirection = V;

            float viewHeight = length(worldPosition);

            float3 luminance = 0;

            float3 sunDirection = SunDirection;

            if (viewHeight < atmosphere.TopRadius)
            {
                float2 uv;
                float3 upVector = normalize(worldPosition);
                float viewZenithCosAngle = dot(worldDirection, upVector);

                float3 sideVector = normalize(cross(upVector, worldDirection)); // Assumes non parallel vectors
                float3 forwardVector = normalize(cross(sideVector, upVector)); // Aligns toward the sun light but perpendicular to up vector
                float2 lightOnPlane = float2(dot(sunDirection, forwardVector), dot(sunDirection, sideVector));
                lightOnPlane = normalize(lightOnPlane);
                float lightViewCosAngle = lightOnPlane.x;

                bool intersectGround = RaySphereIntersectNearest(worldPosition, worldDirection, float3(0, 0, 0), atmosphere.BottomRadius) >= 0.0f;

                SkyViewLutParamsToUv(atmosphere, intersectGround, viewZenithCosAngle, lightViewCosAngle, viewHeight, uv);

		        luminance = SkyViewLUT.SampleLevel(SamplerLinearClamp, uv, 0).rgb;
            }
            else
            {
                // Move to top atmosphere as the starting point for ray marching.
		        // This is critical to be after the above to not disrupt above atmosphere tests and voxel selection.
		        if (MoveToTopAtmosphere(worldPosition, worldDirection, atmosphere.TopRadius))
		        {
			        // Apply the start offset after moving to the top of atmosphere to avoid black pixels
			        worldPosition += worldDirection * AP_START_OFFSET_KM;

			        float3 sunIlluminance = SunColor;

			        const float tDepth = 0.0;
			        const float sampleCountIni = 0.0;
			        const bool variableSampleCount = true;
			        const bool opaque = false;
			        const bool ground = false;
			        const bool mieRayPhase = true;
			        const bool multiScatteringApprox = true;
			        SingleScatteringResult ss = IntegrateScatteredLuminance(
				        atmosphere, pixelPosition, worldPosition, worldDirection, sunDirection, sunIlluminance, tDepth, sampleCountIni, variableSampleCount,
				        opaque, ground, mieRayPhase, multiScatteringApprox, TransmittanceLUT, MultiScatteringLUT);

			        luminance = ss.L;
		        }
            }

            float3 totalColor = luminance;

			// --- Wispy cirrus layer at 5000 m (renders behind main clouds) ---
			float cirrusDensity = 0;
			float tCirrus = TracePlane(CameraPosition, worldDirection, float3(0, 5000, 0), float3(0, -1, 0));
			if (tCirrus > 0)
			{
				float3 cirrusPos = CameraPosition + worldDirection * tCirrus;
				cirrusDensity = CalculateCirrus(cirrusPos);
				if (cirrusDensity > 0.001f)
				{
					float3 atmTransmittance = GetAtmosphericLightTransmittance(atmosphere, cirrusPos, SunDirection, TransmittanceLUT);
					float3 cirrusColor = GetCirrusLighting(cirrusPos, SunDirection, SunColor * atmTransmittance, cirrusDensity);
					totalColor = lerp(totalColor, cirrusColor, cirrusDensity);
				}
			}

			// --- Main cloud layer at 1000 m ---
			CloudResult cloud = (CloudResult)0;
			float t = TracePlane(CameraPosition, worldDirection, float3(0, 1000, 0), float3(0, -1, 0));
			if (t > 0)
			{
				float3 cloudPos = CameraPosition + worldDirection * t;
				cloud.density = CalculateClouds(cloudPos);

				float3 atmTransmittance = GetAtmosphericLightTransmittance(atmosphere, cloudPos, SunDirection, TransmittanceLUT);
				float3 cloudColor = GetCloudLighting(cloudPos, SunDirection, SunColor * atmTransmittance, cloud.density);

				totalColor = lerp(totalColor, cloudColor, cloud.density);
			}

			if (!RenderSun)
			{
				// This makes the night blue tinted and not good looking, might make more sense to cheat the ambient color instead ...
				// but it all looks bad ...
				float nightFactor = saturate(-sunDirection.y / 0.05);
				float3 nightColor = float3(0.02, 0.05, 0.15) * 0.1;
				totalColor = lerp(totalColor, nightColor, nightFactor * 1);
			}

			if (RenderSun)
			{
				float3 sunIlluminance = SunColor;
				float3 sun = GetSunLuminance(worldPosition, worldDirection, sunDirection, sunIlluminance, atmosphere, TransmittanceLUT);

				// Sun transmittance through cloud layers
				float sunTau = cloud.density * 40.0 + cirrusDensity * 6.0;
				sun *= exp(-sunTau);
				totalColor += sun;
			}

            if (EnableHeightFog && RenderSun)
            {
		        const float3 planetCenter = atmosphere.PlanetCenter * SKY_UNIT_TO_M;
		        const float bottomRadius = atmosphere.BottomRadius * SKY_UNIT_TO_M;
		        const float topRadius = bottomRadius + Fog.HeightEnd;
                const float3 rayOrigin = CameraPosition;
                const float3 rayDirection = V;
		        float dist = RaySphereIntersectNearest(rayOrigin, rayDirection, planetCenter, topRadius);

		        if(dist >= 0)
		        {
			        // Offset origin with fog start value.
			        // We can't do this with normal distance due to infinite distance.
			        const float3 offsetO = rayOrigin + rayDirection * Fog.Start;
                    float4 fogColor = GetFogColor(Fog, atmosphere, dist, offsetO, rayDirection, sunDirection, SunColor, SkyLuminanceLUT, TransmittanceLUT);
			        if (fogColor.a > 0) // this check avoids switching to fully fogged above fog level camera at zero density
			        {
				        if (length(rayOrigin - planetCenter) > topRadius) // check if we are above fog height sphere
				        {
					        // hack: flip fog when camera is above
					        fogColor.a = 1 - fogColor.a; // this only supports non-premultiplied fog
				        }
				        totalColor = lerp(totalColor, fogColor.rgb, fogColor.a); // non-premultiplied fog
			        }
		        }
            }

			totalColor = clamp(totalColor, 0, 65000);
            return float4(totalColor.xyz, 1);
        }

		float TracePlane(float3 o, float3 d, float3 planeOrigin, float3 planeNormal)
		{
			return dot(planeNormal, (planeOrigin - o) / dot(planeNormal, d));
		}

		float2 Hash(float2 p)
		{
			p = float2(dot(p, float2(127.1, 311.7)), dot(p, float2(269.5, 183.3)));
			return -1.0 + 2.0 * frac(sin(p) * 43758.5453123);
		}

		float Noise(in float2 p)
		{
			const float K1 = 0.366025404; // (sqrt(3)-1)/2;
			const float K2 = 0.211324865; // (3-sqrt(3))/6;
			float2 i = floor(p + (p.x + p.y) * K1);
			float2 a = p - i + (i.x + i.y) * K2;
			float2 o = (a.x > a.y) ? float2(1.0, 0.0) : float2(0.0, 1.0);
			float2 b = a - o + K2;
			float2 c = a - 1.0 + 2.0 * K2;
			float3 h = max(0.5 - float3(dot(a, a), dot(b, b), dot(c, c)), 0.0);
			float3 n = h * h * h * h * float3(dot(a, Hash(i + 0.0)), dot(b, Hash(i + o)), dot(c, Hash(i + 1.0)));
			return dot(n, float3(70.0, 70.0, 70.0));
		}

		struct CloudResult
		{
			float density;
		};

		// Evaluates cloud density at a given world-space cloud-layer position.
		// Returns density in [0, 1].
		float CalculateClouds(float3 cloudPos)
		{
			const float2 cloudUV = cloudPos.xz * Clouds.Scale;
			const float cloudTime = Time * Clouds.Speed;
			const float2x2 m = float2x2(1.6, 1.2, -1.2, 1.6);
			const uint quality = 6; // 6 octaves is a good quality/cost tradeoff

			// --- Domain warp (flow distortion) ---
			float2 warp = 0;
			{
				float2 uv = cloudUV * 0.5f;
				float amount = 0.1;
				for (uint i = 0; i < quality; i++)
				{
					warp += Noise(uv) * amount;
					uv = mul(m, uv);
					amount *= 0.4;
				}
			}

			// --- Base shape: multi-octave FBM ---
			float clouds = 0.0;
			{
				const float time = cloudTime * 0.2f;
				float density = 1.1f;
				float2 uv = cloudUV * 0.8f;
				uv -= warp - time;
				for (uint i = 0; i < quality; i++)
				{
					clouds += density * Noise(uv);
					uv = mul(m, uv) + time;
					density *= 0.6f;
				}
			}

			// --- Detail erosion: ridged noise carves the soft cloud edges ---
			{
				float detail = 0.0;
				const float time = cloudTime * 0.1f;
				float weight = 0.8f;
				float2 uv = cloudUV;
				uv -= warp - time;
				for (uint i = 0; i < quality; i++)
				{
					detail += abs(weight * Noise(uv));
					uv = mul(m, uv) + time;
					weight *= 0.7f;
				}
				// Subtract detail from soft edges only (dense core is preserved)
				// Erosion scales WITH cloudiness: complex detail when overcast, smooth sparse shapes when clear
				float erosion = 0.5 * pow(saturate(Clouds.Cloudiness), 1.5);
				clouds -= detail * erosion * saturate(1.0 - clouds);
			}

			// --- Fine-detail turbulence ---
			// High-frequency pass adds small-scale lumpiness; strength scales with cloudiness
			// so sparse clouds stay cleanly shaped and detail builds up toward overcast.
			{
				float fineDetail = 0.0;
				const float fdTime = cloudTime * 0.15f;
				float weight = 0.5f;
				float2 fdUV = cloudUV * 3.5f;
				fdUV -= warp - fdTime;
				for (uint i = 0; i < 4; i++)
				{
					fineDetail += weight * abs(Noise(fdUV));
					fdUV = mul(m, fdUV) + fdTime;
					weight *= 0.6f;
				}
				clouds -= fineDetail * 0.28f * pow(saturate(Clouds.Cloudiness), 1.5) * saturate(1.0f - clouds);
			}

			// --- Coverage remapping ---
			// lerp between choppy cumulus and flat overcast based on cloudiness
			clouds = lerp(clouds * 9.0f * Clouds.Cloudiness + 0.3f, clouds * 0.5f + 0.5f, pow(saturate(Clouds.Cloudiness), 8));
			clouds = saturate(clouds - (1.0 - Clouds.Cloudiness));

			// --- Horizon fade ---
			clouds *= pow(saturate(1.0 - length(cloudPos.xz) * 0.00001f), 16);

			// --- Interior texture ---
			// The coverage remapping saturates interior FBM values to 1.0, which collapses
			// all density variation inside the blob.  This pass re-introduces that variation
			// by modulating the FINAL density after clamping, so the effect is always visible.
			// Multiplying by `clouds` keeps clear-sky pixels untouched.
			{
				float interior = 0.0f;
				float weight = 1.0f;
				float2 uv = cloudUV * 1.8f + cloudTime * 0.07f;
				for (uint i = 0; i < 6; i++)
				{
					interior += weight * Noise(uv);
					uv = mul(m, uv);
					weight *= 0.5f;
				}
				interior /= 1.9375f; // normalise: 1+0.5+0.25+0.125+0.0625+0.03125
				// str scales with cloudiness so sparse clouds keep clean edges
				float str = 0.6f * pow(saturate(Clouds.Cloudiness), 0.6f);
				clouds = saturate(clouds + interior * str * clouds);
			}

			return clouds;
		}

		// Cloud lighting using dual-lobe Henyey-Greenstein scattering with a
		// physically-motivated multiple-scatter base to keep clouds bright.
		//
		// Key insight: the density value here is a 2D coverage alpha (0-1), NOT a
		// volumetric extinction coefficient in km^-1.  Applying Beer-Lambert directly
		// to it collapses brightness to near-zero.  Instead we model the high-albedo
		// multiple-scattering that makes real clouds appear bright from all angles, then
		// add a directional phase contribution on top for silver linings and sunset glow.
		float3 GetCloudLighting(float3 worldPos, float3 lightDir, float3 lightColor, float density)
		{
			float3 viewDir = normalize(CameraPosition - worldPos);
			float cosAngle = dot(viewDir, lightDir); // +1 = camera looking toward sun

			// Dual-lobe HG phase function.
			// HgPhase() uses the -cosTheta convention internally, so:
			//   g < 0  →  bright when cosAngle = +1  (forward scatter / silver lining)
			//   g > 0  →  bright when cosAngle = -1  (backward scatter / underside glow)
			float phaseForward  = HgPhase(-0.75, cosAngle); // silver lining toward sun
			float phaseBackward = HgPhase( 0.35, cosAngle); // glow on lit underside
			float phase = phaseForward * 0.5 + phaseBackward * 0.5;

			// Multiple-scatter base: real cloud droplets have albedo ~0.99, so light
			// bounces many times and illuminates the cloud nearly isotropically.
			// Model this as a large isotropic constant + smaller directional lobe.
			float multiScatterBase = 0.65;
			float totalPhase = multiScatterBase + (1.0 - multiScatterBase) * phase;

			// Gentle self-shadowing: thick cloud interiors are slightly darker than edges.
			// Use a small coefficient — density is an alpha, not a physical thickness.
			float selfShadow = exp(-density * 0.8);

			// Subtle edge brightening: thin cloud edges catch slightly more direct light.
			float edgeBright = 1.0 + 0.25 * (1.0 - density);

			float3 directLight = lightColor * totalPhase * selfShadow * edgeBright;

			// Ambient from sky (attenuated by density for approximate self-shadowing).
			float3 skyAmbient = SkyLuminanceLUT.SampleLevel(SamplerLinearClamp, float2(0.5, 0.5), 0).rgb;
			float3 ambient    = skyAmbient * selfShadow * 0.3;

			return directLight + ambient;
		}

		// Evaluates thin cirrus cloud density at a given world-space position.
		// Cirrus are high-altitude ice clouds with characteristic streaky wind-shear wisps.
		// CirrusAmount (0-1) gates the overall visibility.
		float CalculateCirrus(float3 cloudPos)
		{
			const float cloudTime = Time * Clouds.Speed * 0.25f;

			// Anisotropic UVs: strongly stretched along X to simulate wind-streak direction.
			float2 uv = float2(cloudPos.x * Clouds.Scale * 0.08f, cloudPos.z * Clouds.Scale * 0.35f);
			uv -= float2(cloudTime * 0.7f, cloudTime * 0.05f);

			const float2x2 m = float2x2(1.6f, 1.2f, -1.2f, 1.6f);

			// Ridged FBM: peaks of (1 - |noise|) create thin bright streaks
			float cirrus = 0.0f;
			float weight = 0.8f;
			for (uint i = 0; i < 4; i++)
			{
				cirrus += weight * (1.0f - abs(Noise(uv)));
				uv = mul(m, uv) + cloudTime * 0.08f;
				weight *= 0.55f;
			}
			cirrus /= 1.8f; // approximate normalise to [0,1]

			// Keep only the bright peaks (wispy thin streaks, not a solid layer)
			cirrus = pow(saturate((cirrus - 0.4f) * (1.0f / 0.6f)), 1.8f);

			// Horizon fade - wider radius since cirrus is at 5000 m
			cirrus *= pow(saturate(1.0f - length(cloudPos.xz) * 0.0000025f), 8);

			return saturate(cirrus * Clouds.CirrusAmount);
		}

		// Lighting for thin cirrus: strong forward-scatter halo from ice crystals.
		float3 GetCirrusLighting(float3 worldPos, float3 lightDir, float3 lightColor, float density)
		{
			float3 viewDir = normalize(CameraPosition - worldPos);
			float cosAngle = dot(viewDir, lightDir);

			// Ice crystals produce a strong narrow forward-scatter lobe (sun halo)
			// and a broader secondary lobe for overall translucency.
			float phaseNarrow = HgPhase(-0.85f, cosAngle);
			float phaseBroad  = HgPhase(-0.25f, cosAngle);
			float phase = phaseNarrow * 0.6f + phaseBroad * 0.4f;

			// Very thin cloud: minimal self-shadowing, slight edge brightening
			float3 directLight = lightColor * phase * (1.2f - density * 0.4f);

			float3 skyAmbient = SkyLuminanceLUT.SampleLevel(SamplerLinearClamp, float2(0.5f, 0.5f), 0).rgb;
			float3 ambient    = skyAmbient * 0.08f;

			return directLight + ambient;
		}
    };
}
