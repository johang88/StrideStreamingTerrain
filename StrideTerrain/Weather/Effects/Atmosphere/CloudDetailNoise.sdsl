namespace StrideTerrain.Weather.Effects.Atmosphere
{
    // Generates the 32^3 high-frequency detail volume used to erode the base
    // cloud shape (ported from skygl detail_noise.comp).
    //   R = 1 - Worley @ 8 cells   (inverted)
    //   G = 1 - Worley @ 16 cells  (inverted)
    //   B = 1 - Worley @ 32 cells  (inverted)
    //   A = R*0.625 + G*0.25 + B*0.125  (pre-composited detail FBM;
    //       lets the density function do a single fetch)
    //
    // All noise calls pass a period equal to their cell count so the volume
    // wraps seamlessly.
    shader CloudDetailNoise : Noise
    {
        stage RWTexture3D<float4> OutputTexture;

        cbuffer NoiseParams
        {
            uint TextureSize;
        }

        override void Compute()
        {
            uint3 id = streams.DispatchThreadId.xyz;
            if (id.x >= TextureSize || id.y >= TextureSize || id.z >= TextureSize)
                return;

            float sizeF = TextureSize;
            float3 f = float3(id);

            float r = 1.0 - Worley(f * (8.0 / sizeF), 8.0);   // skygl 1 - worley(f*0.25)
            float g = 1.0 - Worley(f * (16.0 / sizeF), 16.0); // skygl 1 - worley(f*0.5)
            float b = 1.0 - Worley(f * (32.0 / sizeF), 32.0); // skygl 1 - worley(f)

            float detail = r * 0.625 + g * 0.25 + b * 0.125;

            OutputTexture[id] = float4(r, g, b, detail);
        }
    };
}
