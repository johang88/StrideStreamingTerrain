namespace StrideTerrain.Weather.Effects.Atmosphere
{
    // Pass 2: Full-resolution reconstruction from quarter-res trace.
    // Each frame, one sub-pixel position (determined by 4x4 Bayer) was traced.
    // Pixels matching that position read directly from the trace buffer.
    // All other pixels use reprojected history (with variance clamping).
    shader CloudReconstruct : ComputeShaderBase, AtmosphereBase, CloudBase
    {
        stage Texture2D<float4> TraceTexture;      // quarter-res trace output (all pixels fresh)
        stage Texture2D<float4> HistoryTexture;     // previous frame's full-res reconstruction
        stage RWTexture2D<float4> OutputTexture;    // current frame full-res reconstruction

        cbuffer ReconstructParams
        {
            CloudParameters Clouds;
            AtmosphereParameters Atmosphere;
            float4x4 PrevViewProjection;
            float4x4 InvViewProjection;
            float3 CameraPosition;
            float2 FullResolution;
            float2 TraceResolution;
            uint FrameIndex;
        }

        // Same inverse Bayer lookup as trace pass
        uint2 GetBayerOffset(uint slot)
        {
            if (slot ==  0) return uint2(0, 0);
            if (slot ==  1) return uint2(2, 2);
            if (slot ==  2) return uint2(2, 0);
            if (slot ==  3) return uint2(0, 2);
            if (slot ==  4) return uint2(1, 1);
            if (slot ==  5) return uint2(3, 3);
            if (slot ==  6) return uint2(3, 1);
            if (slot ==  7) return uint2(1, 3);
            if (slot ==  8) return uint2(1, 0);
            if (slot ==  9) return uint2(3, 2);
            if (slot == 10) return uint2(3, 0);
            if (slot == 11) return uint2(1, 2);
            if (slot == 12) return uint2(0, 1);
            if (slot == 13) return uint2(2, 3);
            if (slot == 14) return uint2(2, 1);
            return uint2(0, 3); // slot 15
        }

        override void Compute()
        {
            uint2 pixelCoord = streams.DispatchThreadId.xy;
            uint fullW = (uint)FullResolution.x;
            uint fullH = (uint)FullResolution.y;

            if (pixelCoord.x >= fullW || pixelCoord.y >= fullH)
                return;

            // Was this pixel freshly traced this frame?
            uint bayerSlot = FrameIndex % 16;
            uint2 bayerOffset = GetBayerOffset(bayerSlot);
            uint2 withinTile = pixelCoord % 4;
            bool isFresh = (withinTile.x == bayerOffset.x && withinTile.y == bayerOffset.y);

            // Quarter-res coordinate for this pixel
            uint2 quarterCoord = pixelCoord / 4;

            // ── Reproject to find history UV ──
            float2 uv = (float2(pixelCoord) + 0.5) / FullResolution;

            float4 unprojected = mul(float4(uv * float2(2.0, -2.0) - float2(1.0, -1.0), 0, 1), InvViewProjection);
            unprojected.xyz /= unprojected.w;
            float3 rayDir = normalize(unprojected.xyz - CameraPosition);

            float3 planetCenter = Atmosphere.PlanetCenter * SKY_UNIT_TO_M;
            float bottomRadiusM = Atmosphere.BottomRadius * SKY_UNIT_TO_M;
            float midLayerHeight = Clouds.LayerBottom + Clouds.LayerThickness * 0.5;
            float midRadius = bottomRadiusM + midLayerHeight;

            float2 tMid = RaySphereIntersect(CameraPosition, rayDir, planetCenter, midRadius);
            float reprojectDist = max(tMid.x, tMid.y);
            if (reprojectDist <= 0.0)
                reprojectDist = midLayerHeight;

            float3 cloudWorldPos = CameraPosition + rayDir * reprojectDist;
            float4 prevClip = mul(float4(cloudWorldPos, 1.0), PrevViewProjection);
            // prevClip.w <= 0 means the point was behind the previous camera —
            // the projected UV can still land in [0,1] and would sample garbage.
            bool historyValid = prevClip.w > 0.0 && FrameIndex >= 1;
            float2 prevUV = (prevClip.xy / max(prevClip.w, 0.0001)) * float2(0.5, -0.5) + 0.5;
            historyValid = historyValid
                             && prevUV.x >= 0.0 && prevUV.x <= 1.0
                             && prevUV.y >= 0.0 && prevUV.y <= 1.0;

            // Neighborhood bounds of the fresh quarter-res trace around this pixel.
            // Used to clamp reprojected history so stale colors (e.g. from a fast
            // camera rotation) get rectified within a few frames instead of
            // persisting for hundreds of frames.
            float4 nMin = TraceTexture[quarterCoord];
            float4 nMax = nMin;
            [unroll]
            for (int dy = -1; dy <= 1; dy++)
            {
                [unroll]
                for (int dx = -1; dx <= 1; dx++)
                {
                    int2 nc = clamp(int2(quarterCoord) + int2(dx, dy), int2(0, 0),
                                    int2(TraceResolution) - int2(1, 1));
                    float4 n = TraceTexture[nc];
                    nMin = min(nMin, n);
                    nMax = max(nMax, n);
                }
            }

            // Pad the clamp window by half the local range: a tight clamp forces
            // the jittered trace noise straight into the output (grain in dense
            // dark clouds); padding lets temporal averaging smooth it while still
            // rejecting stale history within a few frames.
            float4 nPad = (nMax - nMin) * 0.5;
            nMin -= nPad;
            nMax += nPad;

            float4 result;

            if (isFresh)
            {
                // This pixel was traced this frame — read from quarter-res trace.
                // Blend lightly with reprojected history for temporal smoothing.
                float4 traceResult = TraceTexture[quarterCoord];

                if (historyValid)
                {
                    float4 historyColor = HistoryTexture.SampleLevel(SamplerLinearClamp, prevUV, 0);
                    historyColor = clamp(historyColor, nMin, nMax);
                    result = lerp(traceResult, historyColor, 0.7);
                }
                else
                {
                    result = traceResult;
                }
            }
            else if (historyValid)
            {
                // Not freshly traced — reprojected history, variance-clamped to the
                // current trace neighborhood (Flower-style + clamp).
                float4 historyColor = HistoryTexture.SampleLevel(SamplerLinearClamp, prevUV, 0);
                result = clamp(historyColor, nMin, nMax);
            }
            else
            {
                // No valid history and not traced — bilinear sample from quarter-res trace
                float2 traceUV = (float2(quarterCoord) + 0.5) / TraceResolution;
                result = TraceTexture.SampleLevel(SamplerLinearClamp, traceUV, 0);
            }

            OutputTexture[pixelCoord] = result;
        }
    };
}
