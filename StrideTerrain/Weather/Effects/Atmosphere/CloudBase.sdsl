namespace StrideTerrain.Weather.Effects.Atmosphere
{
    shader CloudBase
    {
        struct CloudParameters
        {
            // row 0
            float Coverage;
            float CloudType;
            float Precipitation;
            float WindSpeed;

            // row 1
            float2 WindDirection;
            float LayerBottom;
            float LayerThickness;

            // row 2
            float HighCloudsHeight;
            float CirrusAmount;
            float AltoAmount;
            float SigmaS;

            // row 3
            float SigmaA;
            float WeatherMapScale;
            float BaseNoiseScale;
            float DetailNoiseScale;

            // row 4
            float HighCloudsScale;
            float MaxDistance;
            uint StepCount;
            uint LightStepCount;
        };
    };
}
