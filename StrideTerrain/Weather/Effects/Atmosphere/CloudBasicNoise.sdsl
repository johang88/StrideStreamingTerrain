namespace StrideTerrain.Weather.Effects.Atmosphere
{
    // Generates the 128^3 base cloud shape volume (Horizon Zero Dawn layout,
    // ported from skygl base_noise.comp).
    //   R = Perlin-Worley composite (low-frequency base shape)
    //   G = raw Worley F1 distance @ 32 cells
    //   B = raw Worley F1 distance @ 64 cells
    //   A = raw Worley F1 distance @ 128 cells
    //
    // G/B/A are stored RAW (not inverted, not FBM). The consumer builds
    //   lowFBM = G*0.625 + B*0.25 + A*0.125
    //   density = Remap(R, -(1 - lowFBM), 1, 0, 1)
    // exactly like skygl clouds_pass.frag.
    //
    // All noise calls pass a period equal to their cell count so the volume
    // wraps seamlessly.
    shader CloudBasicNoise : Noise
    {
        stage RWTexture3D<float4> OutputTexture;

        cbuffer NoiseParams
        {
            uint TextureSize;
        }

        override void Compute()
        {
            uint3 id = streams.DispatchThreadId.xyz;
            if (id.x >= TextureSize || id.y >= TextureSize || id.z >= TextureSize)
                return;

            float sizeF = TextureSize;
            float3 f = float3(id);

            // Perlin FBM, 4 octaves, base frequency = 4 cells across the volume.
            // period = 4 at octave 0, doubling each octave -> 4,8,16,32 cells.
            // The normalized FBM has a small standard deviation (~0.12), so
            // stretch by 2.5 to use the full [0,1] range — without this the base
            // shape has almost no contrast and clouds turn into uniform haze.
            float p = PerlinFbm(f * (4.0 / sizeF), 4.0, 4);
            p = saturate(p * 2.5 * 0.5 + 0.5);

            // skygl: w = 1.0 - worley(f * 0.125) / 0.866  (0.125 * 128 = 16 cells)
            float w = saturate(1.0 - Worley(f * (16.0 / sizeF), 16.0) / 0.866);

            float4 result;
            result.r = Remap(p, 0.0, 1.0, w, 1.0);       // Perlin-Worley base
            result.g = Worley(f * (32.0 / sizeF), 32.0); // raw distance, 32 cells
            result.b = Worley(f * (64.0 / sizeF), 64.0); // raw distance, 64 cells
            result.a = Worley(f * (128.0 / sizeF), 128.0); // raw distance, 128 cells

            OutputTexture[id] = result;
        }
    };
}
