namespace StrideTerrain.Weather.Effects.Atmosphere
{
    // Volumetric cloud density + lighting, ported from skygl (clouds_pass.frag, MIT).
    // Density is a UNITLESS [0,1] value; extinction comes from SigmaS/SigmaA.
    shader VolumetricClouds : AtmosphereBase, CloudBase
    {
        struct VolumetricCloudResult
        {
            float3 scattering;
            float transmittance;
            float depth;
        };

        // ── Sampler for the precomputed noise / weather textures (wrapping) ──
        stage SamplerState SamplerLinearWrap
        {
            Filter = MIN_MAG_MIP_LINEAR;
            AddressU = Wrap;
            AddressV = Wrap;
            AddressW = Wrap;
        };

        // ── Remap utility (saturating) ──
        float Remap(float value, float oldMin, float oldMax, float newMin, float newMax)
        {
            return newMin + saturate((value - oldMin) / (oldMax - oldMin)) * (newMax - newMin);
        }

        // ── 3-archetype height gradient (skygl) ──
        // cloudType: 0 = stratus, 0.5 = cumulus, 1 = cumulonimbus
        float HeightGradient(float h, float cloudType)
        {
            float stratus = smoothstep(0.0, 0.07, h) * smoothstep(0.2, 0.07, h);
            float cumulus = smoothstep(0.0, 0.2, h) * smoothstep(0.65, 0.35, h);
            float cumulonimbus = smoothstep(0.0, 0.1, h) * smoothstep(0.95, 0.4, h);

            float a = 1.0 - cloudType;
            return a * a * stratus
                 + 2.0 * cloudType * a * cumulus
                 + cloudType * cloudType * cumulonimbus;
        }

        // ── Sample cloud density (skygl SampleDensity) ──
        // Weather map channels: R = coverage, G = precipitation, B = type.
        // Returns a unitless [0,1] density. cheapLod skips detail erosion and
        // returns the pre-erosion base density (used by the light march).
        float SampleDensity(
            float3 worldPos,
            CloudParameters clouds, AtmosphereParameters atmosphere,
            Texture3D<float4> basicNoiseTexture,
            Texture3D<float4> detailNoiseTexture,
            Texture2D<float4> weatherMapTexture,
            float time, bool cheapLod)
        {
            float3 planetCenter = atmosphere.PlanetCenter * SKY_UNIT_TO_M;
            float bottomRadiusM = atmosphere.BottomRadius * SKY_UNIT_TO_M;
            float innerR = bottomRadiusM + clouds.LayerBottom;

            float heightFraction = (length(worldPos - planetCenter) - innerR) / clouds.LayerThickness;
            if (heightFraction < 0.0 || heightFraction > 1.0)
                return 0.0;

            // Wind-scrolled sample position (with a mild wind skew toward the top).
            float3 windDir3D = float3(clouds.WindDirection.x, 0, clouds.WindDirection.y);
            float3 samplePos = worldPos + windDir3D * clouds.WindSpeed * time;
            samplePos += windDir3D * heightFraction * 500.0;

            // ── Weather map: R = coverage, G = precipitation, B = type ──
            float2 weatherUV = samplePos.xz / clouds.WeatherMapScale;
            float3 weather = weatherMapTexture.SampleLevel(SamplerLinearWrap, weatherUV, 0).rgb;
            float coverage = weather.r;
            float precipitation = weather.g;
            float cloudType = weather.b;
            float heightGradient = HeightGradient(heightFraction, cloudType);

            // ── Base shape ──
            float3 baseUV = samplePos / clouds.BaseNoiseScale;
            float4 baseN = basicNoiseTexture.SampleLevel(SamplerLinearWrap, baseUV, 0);
            float lowFBM = baseN.g * 0.625 + baseN.b * 0.25 + baseN.a * 0.125;
            float baseCloud = Remap(baseN.r, -(1.0 - lowFBM), 1.0, 0.0, 1.0);

            // Contrast window calibrated to our noise distributions (baseCloud
            // lands in ~[0.6, 0.95] after the dilation above; measured offline).
            // Without this the coverage remap below behaves almost binarily:
            // nothing below coverage ~0.2, uniform haze above it.
            baseCloud = Remap(baseCloud, 0.6, 0.95, 0.0, 1.0);

            // ── Compose with coverage + height gradient ──
            baseCloud = Remap(baseCloud, 1.0 - coverage, 1.0, 0.0, 1.0);
            baseCloud *= coverage;
            baseCloud *= heightGradient;

            if (baseCloud <= 0.0)
                return 0.0;

            // Cheap LOD path (light march): skip detail fetch.
            if (cheapLod)
                return saturate(baseCloud);

            // ── Detail erosion (A channel = pre-composited FBM) ──
            // HZD/WickedEngine height-varying erosion: at the cloud bottom carve
            // with INVERTED detail (billowy rounded undersides), toward the top
            // erode with regular detail (wispy cauliflower edges). Slight vertical
            // UV shear keeps repeating detail cells from reading as columns.
            float3 detailUV = samplePos / clouds.DetailNoiseScale;
            detailUV.xz += heightFraction * 0.7;
            float detailFBM = detailNoiseTexture.SampleLevel(SamplerLinearWrap, detailUV, 0).a;
            float detailModifier = lerp(1.0 - detailFBM, detailFBM, saturate(heightFraction * 5.0));
            float detailCloud = Remap(baseCloud, detailModifier * 0.35, 1.0, 0.0, 1.0);

            // Precipitation: denser, heavier cloud (the pow lifts mid densities,
            // the multiplier deepens extinction -> darker rain bases).
            float density = pow(saturate(detailCloud), lerp(1.0, 0.6, precipitation));
            density *= lerp(1.0, 1.8, precipitation);
            return density;
        }

        // ── Multiple-octave scattering approximation (skygl) ──
        // sigmaT = SigmaS + SigmaA. HgPhase's convention has the opposite sign on
        // the cos term vs skygl's HenyeyGreenstein, so skygl g -> -g here.
        float MultipleOctaveScattering(float density, float mu, float sigmaT)
        {
            const float attenuation = 0.5;
            const float contribution = 0.6;
            const float phaseAttenuation = 0.2;
            const float scatteringOctaves = 4.0;

            float a = 1.0;
            float b = 1.0;
            float c = 1.0;

            float luminance = 0.0;

            for (float i = 0.0; i < scatteringOctaves; i++)
            {
                // skygl: mix(HG(-0.2*c, mu), HG(0.8*c, mu), 0.3)
                float phase = lerp(HgPhase(0.2 * c, mu), HgPhase(-0.8 * c, mu), 0.3);
                luminance += b * phase * exp(-sigmaT * density * a);

                a *= attenuation;
                b *= contribution;
                c *= phaseAttenuation;
            }

            return luminance;
        }

        // ── Intersect the cloud shell (skygl IntersectCloudLayer) ──
        bool IntersectCloudLayer(float3 ro, float3 rd, float3 center, float innerR, float outerR,
            out float tEnter, out float tExit)
        {
            tEnter = 0.0;
            tExit = 0.0;

            float2 inner = RaySphereIntersect(ro, rd, center, innerR);
            float2 outer = RaySphereIntersect(ro, rd, center, outerR);

            float tInnerNear = inner.x;
            float tInnerFar = inner.y;
            float tOuterNear = outer.x;
            float tOuterFar = outer.y;

            float distToCenter = length(ro - center);

            if (distToCenter < innerR) // below layer
            {
                tEnter = tInnerFar;
                tExit = tOuterFar;
            }
            else if (distToCenter < outerR) // inside layer
            {
                tEnter = 0.0;
                tExit = (tInnerNear > 0.0) ? tInnerNear : tOuterFar;
            }
            else // above layer
            {
                if (tOuterNear < 0.0) return false;
                tEnter = tOuterNear;
                tExit = (tInnerNear > 0.0) ? tInnerNear : tOuterFar;
            }

            if (tExit < 0.0 || tEnter >= tExit) return false;

            tEnter = max(tEnter, 0.0);
            return true;
        }

        // ── Light march toward the sun for self-shadowing (skygl ComputeLightVisibility) ──
        float ComputeLightVisibility(
            float3 pos, float3 sunDir, float mu,
            CloudParameters clouds, AtmosphereParameters atmosphere,
            Texture3D<float4> basicNoiseTexture,
            Texture3D<float4> detailNoiseTexture,
            Texture2D<float4> weatherMapTexture,
            float time, float sigmaT)
        {
            float3 planetCenter = atmosphere.PlanetCenter * SKY_UNIT_TO_M;
            float bottomRadiusM = atmosphere.BottomRadius * SKY_UNIT_TO_M;
            float innerR = bottomRadiusM + clouds.LayerBottom;
            float outerR = innerR + clouds.LayerThickness;

            float tEnter, tExit;
            if (!IntersectCloudLayer(pos, sunDir, planetCenter, innerR, outerR, tEnter, tExit))
                return 0.0;

            tExit = min(tExit, clouds.LayerThickness);

            float steps = max((float)clouds.LightStepCount, 1.0);
            float dt = (tExit - tEnter) / steps;
            float3 startPos = pos + sunDir * tEnter;
            float d = 0.0;

            for (uint i = 0; i < clouds.LightStepCount; i++)
            {
                float3 samplePos = startPos + sunDir * dt * (float)i;
                d += SampleDensity(samplePos, clouds, atmosphere,
                    basicNoiseTexture, detailNoiseTexture, weatherMapTexture, time, true);
            }
            d *= dt;

            return MultipleOctaveScattering(d, mu, sigmaT);
        }

        // ── Main volumetric cloud ray march ──
        VolumetricCloudResult RayMarchClouds(
            float3 rayOrigin, float3 rayDir,
            float3 sunDir, float3 sunColor,
            CloudParameters clouds, AtmosphereParameters atmosphere,
            Texture3D<float4> basicNoiseTexture,
            Texture3D<float4> detailNoiseTexture,
            Texture2D<float4> weatherMapTexture,
            Texture2D<float4> transmittanceLUT, Texture2D<float4> skyLuminanceLUT,
            float time, float jitter)
        {
            VolumetricCloudResult result;
            result.scattering = float3(0, 0, 0);
            result.transmittance = 1.0;
            result.depth = 0.0;

            float3 planetCenter = atmosphere.PlanetCenter * SKY_UNIT_TO_M;
            float bottomRadiusM = atmosphere.BottomRadius * SKY_UNIT_TO_M;
            float innerR = bottomRadiusM + clouds.LayerBottom;
            float outerR = innerR + clouds.LayerThickness;

            // Ray-sphere intersection with the cloud shell (three-case).
            float2 tInner = RaySphereIntersect(rayOrigin, rayDir, planetCenter, innerR);
            float2 tOuter = RaySphereIntersect(rayOrigin, rayDir, planetCenter, outerR);

            float distToCenter = length(rayOrigin - planetCenter);

            float tMin, tMax;

            if (distToCenter < innerR)
            {
                // Camera below cloud layer
                tMin = max(0.0, max(tInner.x, tInner.y));
                tMax = max(0.0, max(tOuter.x, tOuter.y));
            }
            else if (distToCenter < outerR)
            {
                // Camera inside cloud layer
                tMin = 0.0;
                float exitInner = (tInner.x > 0.0 && tInner.y > 0.0) ? min(tInner.x, tInner.y) : -1.0;
                float exitOuter = max(tOuter.x, tOuter.y);
                tMax = (exitInner > 0.0) ? exitInner : exitOuter;
                tMax = max(0.0, tMax);
            }
            else
            {
                // Camera above cloud layer
                if (tOuter.x < 0.0 && tOuter.y < 0.0)
                    return result;

                tMin = min(tOuter.x, tOuter.y);
                if (tMin < 0.0)
                    return result;

                float exitInner = (tInner.x > 0.0) ? min(tInner.x, tInner.y) : -1.0;
                float exitOuter = max(tOuter.x, tOuter.y);
                tMax = (exitInner > 0.0) ? min(exitInner, exitOuter) : exitOuter;
            }

            if (tMax <= tMin)
                return result;

            // Clamp the march to the volumetric render distance.
            tMax = min(tMax, tMin + clouds.MaxDistance);

            float marchSteps = max((float)clouds.StepCount, 1.0);
            float stepSize = (tMax - tMin) / marchSteps;

            float mu = dot(rayDir, sunDir);
            float sigmaT = clouds.SigmaS + clouds.SigmaA;

            // Ambient light from the sky. The LUT sample is a RADIANCE; skygl
            // feeds sky IRRADIANCE (~pi x mean radiance) into the same slot, so
            // scale by pi — without this the shadowed sides / bases of clouds
            // come out much darker than the reference.
            float3 ambient = skyLuminanceLUT.SampleLevel(SamplerLinearClamp, float2(0.5, 0.5), 0).rgb * 3.14159265;

            bool firstHit = true;

            for (uint step = 0; step < clouds.StepCount; step++)
            {
                float t = tMin + (step + jitter) * stepSize;
                float3 pos = rayOrigin + rayDir * t;

                float density = SampleDensity(pos, clouds, atmosphere,
                    basicNoiseTexture, detailNoiseTexture, weatherMapTexture, time, false);

                if (density > 0.0)
                {
                    if (firstHit)
                    {
                        result.depth = t;
                        firstHit = false;
                    }

                    // The light march uses a reduced extinction: the view ray needs the
                    // full sigma to be opaque, but applying that same sigma toward the
                    // sun makes every core pitch black (single-scattering shadowing
                    // over a 4 km path). Real light penetrates much further via
                    // multiple scattering, so the sun march is deliberately thinner.
                    float vis = ComputeLightVisibility(pos, sunDir, mu, clouds, atmosphere,
                        basicNoiseTexture, detailNoiseTexture, weatherMapTexture, time, sigmaT * 0.2);

                    float3 atmTransmittance = GetAtmosphericLightTransmittance(atmosphere, pos, sunDir, transmittanceLUT);
                    float3 sunLight = sunColor * atmTransmittance;

                    float sampleSigmaS = clouds.SigmaS * density;
                    float sampleSigmaT = max(sigmaT * density, 1e-5);

                    // Mild powder darkening in crevices. The literal skygl port
                    // (per-km sigma, x1000) crushes front-lit clouds by ~12x and
                    // makes the whole sky read dark — x100 keeps the effect
                    // subtle (~0.8 at density 0.5).
                    float powder = exp(-density * sampleSigmaT * 100.0);
                    float powderEffect = lerp(1.0, powder, smoothstep(0.5, -0.5, mu));

                    float3 inscatter = (sunLight * vis + ambient) * sampleSigmaS * powderEffect;

                    float stepTrans = exp(-sampleSigmaT * stepSize);
                    result.scattering += result.transmittance * (inscatter - inscatter * stepTrans) / sampleSigmaT;
                    result.transmittance *= stepTrans;

                    if (result.transmittance < 0.01)
                    {
                        result.transmittance = 0.0;
                        break;
                    }
                }
            }

            // Distance fade, only to soften the hard cutoff at MaxDistance.
            // An exponential falloff (skygl's fog hack) made mid-sky clouds
            // ~25% see-through no matter how dense they were, so clouds stay
            // fully opaque out to 60% of the render distance and fade only
            // over the remaining tail.
            float fade = 1.0 - smoothstep(clouds.MaxDistance * 0.6, clouds.MaxDistance, tMin);
            result.scattering *= fade;
            result.transmittance = lerp(1.0, result.transmittance, fade);

            return result;
        }
    };
}
