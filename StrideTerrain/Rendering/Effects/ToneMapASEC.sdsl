namespace StrideTerrain.Rendering.Effects
{
	shader ToneMapASEC : ImageEffectShader, ExposureCommon, PostEffectCommon
	{
		stage override float4 Shading()
		{
			float3 c = Texture0.Sample(PointSampler, streams.TexCoord).xyz;
			c *= GetExposure();

			c = ApplyTonemap(c);
	
			float3 b = InvSimpleToneMap(Texture1.Sample(PointSampler, streams.TexCoord).xyz);
			b = ApplyTonemap(b);
			c += b;

			return float4(c, 1);
		}

		float3 ApplyTonemap(float3 c)
		{
			return TonemapACES(c);
		}

		float3 agx_contrast_approx(float3 x) {
			// Generated with Excel trendline
			// Input data: Generated using python sigmoid with EaryChow's configuration and 57 steps
			// Additional padding values were added to give correct intersections at 0.0 and 1.0
			// 6th order, intercept of 0.0 to remove an operation and ensure intersection at 0.0
			float3 x2 = x * x;
			float3 x4 = x2 * x2;
			return 0.021 * x + 4.0111 * x2 - 25.682 * x2 * x + 70.359 * x4 - 74.778 * x4 * x + 27.069 * x4 * x2;
		}

		float3 tonemap_agx(float3 color) {
			// Combined linear sRGB to linear Rec 2020 and Blender AgX inset matrices:
			// Note: HLSL matrices are row-major, so we transpose the GLSL column-major layout.
			const float3x3 srgb_to_rec2020_agx_inset_matrix = float3x3(
					0.54490813676363087053, 0.37377945959812267119, 0.081384976686407536266,
					0.14044005884001287035, 0.75410959864013760045, 0.10543358536857773485,
					0.088827411851915368603, 0.17887712465043811023, 0.73224999956948382528);
			// Combined inverse AgX outset matrix and linear Rec 2020 to linear sRGB matrices.
			const float3x3 agx_outset_rec2020_to_srgb_matrix = float3x3(
					1.9645509602733325934, -0.85585845117807513559, -0.10886710826831608324,
					-0.29932243390911083839, 1.3264510741502356555, -0.027084020983874825605,
					-0.16436833806080403409, -0.23822464068860595117, 1.402665347143271889);
			// LOG2_MIN      = -10.0
			// LOG2_MAX      =  +6.5
			// MIDDLE_GRAY   =  0.18
			const float min_ev = -12.4739311883324; // log2(pow(2, LOG2_MIN) * MIDDLE_GRAY)
			const float max_ev = 4.02606881166759; // log2(pow(2, LOG2_MAX) * MIDDLE_GRAY)

			color = max(color, 2e-10);
			// Do AGX in rec2020 to match Blender and then apply inset matrix.
			color = mul(srgb_to_rec2020_agx_inset_matrix, color);
			// Log2 space encoding.
			color = clamp(log2(color), min_ev, max_ev);
			color = (color - min_ev) / (max_ev - min_ev);
			// Apply sigmoid function approximation.
			color = agx_contrast_approx(color);
			// Convert back to linear before applying outset matrix.
			color = pow(color, float3(2.4, 2.4, 2.4));
			// Apply outset to make the result more chroma-laden and then go back to linear sRGB.
			color = mul(agx_outset_rec2020_to_srgb_matrix, color);

			return color;
		}

		float3 TonemapACES(float3 c)
		{
			const float3x3 sRGB_2_AP1 = mul(XYZ_2_AP1, mul(D65_2_D60, sRGB_2_XYZ));
			const float3x3 AP1_2_sRGB = mul(XYZ_2_sRGB, mul(D60_2_D65, AP1_2_XYZ));

			// linear sRGB -> AP1
			c = mul(sRGB_2_AP1, c);
			c = Aces(c);

			// AP1 -> linear sRGB
			c = mul(AP1_2_sRGB, c);

			return c;
		}

		// ACES filmic tonemapper with highlight desaturation ("crosstalk").
		// Based on the curve fit by Krzysztof Narkowicz.
		// https://knarkowicz.wordpress.com/2016/01/06/aces-filmic-tone-mapping-curve/
		float3 Aces(float3 x)
		{
			float a = 2.51f;
			float b = 0.03f;
			float c = 2.43f;
			float d = 0.59f;
			float e = 0.14f;

			return saturate((x*(a*x+b))/(x*(c*x+d)+e));
		}

		// http://www.brucelindbloom.com/index.html?Eqn_RGB_XYZ_Matrix.html
		// https://github.com/ampas/aces-dev/blob/master/transforms/ctl/README-MATRIX.md
		static const float3x3 XYZ_2_sRGB = 
		{
				3.2409699419, -1.5373831776, -0.4986107603,
			-0.9692436363,  1.8759675015,  0.0415550574,
				0.0556300797, -0.2039769589,  1.0569715142,
		};

		static const float3x3 sRGB_2_XYZ = 
		{
			0.4124564, 0.3575761, 0.1804375,
			0.2126729, 0.7151522, 0.0721750,
			0.0193339, 0.1191920, 0.9503041,
		};

		static const float3x3 XYZ_2_AP1 = 
		{
				1.6410233797, -0.3248032942, -0.2364246952,
			-0.6636628587,  1.6153315917,  0.0167563477,
				0.0117218943, -0.0082844420,  0.9883948585,
		};

		static const float3x3 AP1_2_XYZ = 
		{
				0.6624541811, 0.1340042065, 0.1561876870,
				0.2722287168, 0.6740817658, 0.0536895174,
			-0.0055746495, 0.0040607335, 1.0103391003,
		};

		static const float3x3 D65_2_D60 = 
		{
				1.01303,    0.00610531, -0.014971,
				0.00769823, 0.998165,   -0.00503203,
			-0.00284131, 0.00468516,  0.924507,
		};

		static const float3x3 D60_2_D65 = 
		{
				0.987224,   -0.00611327, 0.0159533,
			-0.00759836,  1.00186,    0.00533002,
				0.00307257, -0.00509595, 1.08168,
		};
	};
}