namespace StrideTerrain.TerrainSystem.Effects.Material
{
    shader TerrainVirtualTextureSampling : TerrainVirtualTexture
    {
        rgroup PerMaterial
        {
            stage Texture2D<float4> PhysicalDiffuse;
            stage Texture2D<float2> PhysicalNormal;
            stage Texture2D<float> PhysicalRoughness;
        }

        struct VTMaterialSample
        {
            float3 Diffuse;
            float Roughness;
            float3 Normal;
        };

        stage SamplerState PhysicalSampler
        {
            Filter = ANISOTROPIC;
            MaxAnisotropy = 4;
        };

        VTMaterialSample SampleVirtualTerrain(float3 worldPosition, float3 worldNormal)
        {
            VTMaterialSample result;

            //--- Step 1: Compute desired mip level ---
            float mipLevelF = ComputeVTMipLevel(worldPosition);
            int mipLevel = int(floor(mipLevelF));

            //--- Step 2: Page address at chosen mip ---
            VTPageAddress addr = ComputePageAddress(worldPosition, mipLevel);

            //--- Step 3: Compute physical UV (toroidal clipmap — no indirection lookup) ---
            float2 physUV = ComputePhysicalUV(addr);

            //--- Step 4: Out-of-range → return neutral gray ---
            if (physUV.x < 0)
            {
                result.Diffuse   = float3(0.5, 0.5, 0.5);
                result.Roughness = 0.5;
                result.Normal    = worldNormal;
                return result;
            }

            //--- Step 5: Compute gradients and clamp to prevent cross-tile filtering ---
            float2 dUVdx_phys = ddx(physUV);
            float2 dUVdy_phys = ddy(physUV);

            float maxGrad = VT_TILE_SIZE / VT_ATLAS_SIZE * 0.5;
            dUVdx_phys = clamp(dUVdx_phys, -maxGrad, maxGrad);
            dUVdy_phys = clamp(dUVdy_phys, -maxGrad, maxGrad);

            //--- Step 6: Sample physical atlases ---
            float4 diffuseRaw = PhysicalDiffuse.SampleGrad(
                PhysicalSampler, physUV, dUVdx_phys, dUVdy_phys);
            result.Diffuse = diffuseRaw.rgb;

            float2 normalRaw = PhysicalNormal.SampleGrad(
                PhysicalSampler, physUV, dUVdx_phys, dUVdy_phys);
            result.Normal = DecodeOctahedral(normalRaw);

            result.Roughness = PhysicalRoughness.SampleGrad(
                PhysicalSampler, physUV, dUVdx_phys, dUVdy_phys);

            return result;
        }

        float3 DecodeOctahedral(float2 f) {
            f = f * 2.0 - 1.0;
            float3 n = float3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
            float t = saturate(-n.z);
            n.xy += n.xy >= 0.0 ? -t : t;
            return normalize(n);
        }
    };
}
